# Leave unset in development: Vite proxies /api to the server (see vite.config.ts),
# which keeps the refresh cookie first-party.
# Set this only when the API lives on a different origin in production.
# VITE_API_URL=https://api.example.com/api

# Override the dev proxy target if the API is not on port 4000.
# VITE_PROXY_TARGET=http://127.0.0.1:4000
