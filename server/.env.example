# ---------------------------------------------------------------------------
# Savoney API configuration
# Copy to server/.env and fill in. The process validates this on boot and
# refuses to start on anything invalid — see src/config/env.ts.
# ---------------------------------------------------------------------------

NODE_ENV=development
# 4000 rather than 5000: macOS binds 5000 to the AirPlay Receiver service,
# which silently answers requests and returns 403.
PORT=4000
HOST=0.0.0.0

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/savoney

# Two DIFFERENT secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Separate keys mean rotating the refresh secret (ending every session) does not
# have to invalidate in-flight access tokens, and a leaked access secret cannot
# be used to mint refresh tokens.
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-secret

# Access tokens are short-lived; the client silently refreshes them.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins permitted to send credentials.
CORS_ORIGINS=http://localhost:5173

# Where password-reset links point: the browser origin, not the API's.
APP_URL=http://localhost:5173

# SMTP connection string, e.g. smtps://user:pass@smtp.example.com:465
# Optional. Unset in development, reset links are written to the log and
# returned by the API, so the flow works with no mail account. Unset in
# production, the app still runs and password recovery answers 503.
# SMTP_URL=
MAIL_FROM=Savoney <no-reply@savoney.app>
PASSWORD_RESET_TTL_MINUTES=60

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Number of reverse proxies in front of the app. Leave 0 when running directly:
# trusting a proxy that is not there lets a client spoof X-Forwarded-For and
# evade rate limiting entirely.
TRUST_PROXY=0

# Serves Swagger UI at /api/docs. Turn off in production if the API is private.
ENABLE_DOCS=true
